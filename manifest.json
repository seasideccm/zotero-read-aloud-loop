{
	"manifest_version": 2,
	"name": "Read Aloud Loop",
	"version": "1.0.2",
	"description": "Add a loop button to the Zotero Read Aloud bar to repeat the current sentence.",
	"author": "Read Aloud Loop",
	"icons": {
		"48": "content/icon.svg",
		"96": "content/icon.svg"
	},
	"applications": {
		"zotero": {
			"id": "read-aloud-loop@zotero-plugin",
			"update_url": "https://www.zotero.org/",
			"strict_min_version": "7.0",
			"strict_max_version": "*"
		}
	}
}
